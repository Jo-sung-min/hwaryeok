# Next.js 서버 호출과 동일 출처 프록시가 사용할 Spring Boot 원본 주소입니다.
BACKEND_ORIGIN=http://localhost:8081

# 선택 항목입니다. 별도 API 경로가 필요할 때만 전체 주소로 덮어씁니다.
API_URL=http://localhost:8081/api/v1

# 브라우저에는 백엔드 원본 주소 대신 Vercel/Next 동일 출처 경로만 공개합니다.
NEXT_PUBLIC_API_URL=/api/v1

# 제품 이미지 CDN의 공개 기준 주소입니다. 비밀 값이 아니며 Next.js 빌드 시 이미지 허용 목록에도 반영됩니다.
S3_PUBLIC_BASE_URL=https://cdn.hwaryeok.co.kr

# canonical URL, Open Graph, robots.txt, sitemap.xml에 사용하는 프론트 공개 주소입니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
