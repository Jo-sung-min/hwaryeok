# 로컬 개발: 이 파일을 frontend/.env.local로 복사해 사용합니다. 값을 비워 두면 아래 기본값으로 동작합니다.
# 운영(Vercel): Project Settings > Environment Variables에 같은 이름으로 등록합니다.
# 프론트는 DB에 직접 접근하지 않습니다. DB·JWT·카카오·S3 업로드·AWS 키는 백엔드(EB)에만 등록하세요.

# Next.js 서버 호출과 동일 출처 프록시가 사용할 Spring Boot 원본 주소입니다. Vercel에서는 필수입니다.
BACKEND_ORIGIN=http://localhost:8081

# 이메일 로그인 요청의 실제 사용자 주소를 백엔드에 전달할 때 사용하는 서버 전용 공유 비밀값입니다.
# Vercel에서는 필수이며 백엔드와 같은 32자 이상의 값을 사용합니다.
BFF_PROXY_SECRET=replace-with-a-shared-random-secret-at-least-32-characters

# 브라우저에는 백엔드 원본 주소 대신 동일 출처 경로만 공개합니다. Vercel에서는 반드시 /api/v1입니다.
NEXT_PUBLIC_API_URL=/api/v1

# canonical URL, Open Graph, robots.txt, sitemap.xml에 사용하는 프론트 공개 주소입니다. Vercel에서는 HTTPS 주소가 필수입니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# 제품 이미지 CDN의 공개 기준 주소입니다. 비밀 값이 아니며 빌드 시 이미지 허용 목록에 반영됩니다.
S3_PUBLIC_BASE_URL=https://cdn.hwaryeok.co.kr

# 선택 항목(기존 설정 호환용)입니다. 생략하면 BACKEND_ORIGIN/api/v1을 사용하며, 넣을 때는 BACKEND_ORIGIN과 같은 origin이어야 합니다.
# API_URL=http://localhost:8081/api/v1
