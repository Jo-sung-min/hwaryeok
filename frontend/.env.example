# Next.js 서버에서 Spring Boot API를 호출할 때 사용합니다.
API_URL=http://localhost:8080/api/v1

# 브라우저에서 직접 호출하는 기능을 추가할 때 사용합니다.
# 공개되어도 되는 API 주소만 NEXT_PUBLIC_ 변수에 설정하세요.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# 브라우저를 OAuth 인증 시작 주소로 보낼 때 사용하는 공개 백엔드 주소입니다.
# 로컬에서는 생략 가능하며, Vercel에서는 배포된 Spring Boot 공개 주소를 넣습니다.
OAUTH_BACKEND_URL=http://localhost:8080

# canonical URL, Open Graph, robots.txt, sitemap.xml에 사용하는 프론트 공개 주소입니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
