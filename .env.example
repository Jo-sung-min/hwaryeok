DB_URL=jdbc:postgresql://localhost:5432/hwaryeok
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hwaryeok
DB_SCHEMA=hwaryeok
DB_USER=hwaryeok
# 로컬에서도 저장소 기본 비밀번호를 재사용하지 말고 임의 문자열을 설정하세요.
DB_PASSWORD=replace-with-a-strong-local-password
FRONTEND_PORT=3000
BACKEND_PORT=8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
OAUTH_BACKEND_URL=http://localhost:8080
# Supabase Session Pooler의 연결 한도를 넘지 않도록 작게 유지합니다.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
DB_POOL_NAME=HwaryeokPool
DB_POOL_VALIDATION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_POOL_MAX_LIFETIME_MS=1500000
DB_POOL_KEEPALIVE_MS=120000
DB_POOL_LEAK_DETECTION_MS=60000

# 로컬 PostgreSQL로 Spring Boot를 실행할 때 사용합니다.
SPRING_PROFILES_ACTIVE=postgres

CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080
OAUTH_FRONTEND_BASE_URL=http://localhost:3000

# 아래 예시 문구는 그대로 사용하면 시작이 차단됩니다. 서로 다른 32바이트 이상의 임의 값으로 교체하세요.
# 생성 예: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# 면허번호 HMAC용 별도 키입니다. JWT 키와 다른 32바이트 이상 값을 사용하세요.
LICENSE_HASH_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
JWT_ISSUER=hwaryeok-api
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=2592000
OAUTH_EXCHANGE_CODE_SECONDS=120
# 쉼표로 구분한 관리자 계정 이메일입니다. 변경 후에는 다시 로그인해야 새 권한 토큰이 발급됩니다.
ADMIN_EMAILS=wings2530@gmail.com
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_RATE_BLOCK_SECONDS=900
LOGIN_RATE_IDENTITY_ATTEMPTS=8
LOGIN_RATE_ADDRESS_ATTEMPTS=100

# OAuth 앱 키 — 사용하려는 공급자의 두 값을 모두 입력하면 자동 활성화됩니다.
# Redirect URI는 http://localhost:8080/login/oauth2/code/{google|kakao|naver} 형식입니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
