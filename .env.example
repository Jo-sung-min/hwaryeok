DB_NAME=hwaryeok
DB_SCHEMA=hwaryeok
DB_USER=hwaryeok
DB_PASSWORD=replace-with-a-strong-local-password
DB_PORT=5432
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

FRONTEND_PORT=3001
BACKEND_PORT=8081
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1
OAUTH_BACKEND_URL=http://localhost:8081

CORS_ALLOWED_ORIGINS=http://localhost:3001
OAUTH_FRONTEND_BASE_URL=http://localhost:3001
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
LICENSE_HASH_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
ADMIN_EMAILS=wings2530@gmail.com

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# 제품 이미지는 fatell-aws-s3 버킷의 hwaryeok 경로에 저장하고 CDN으로 공개합니다.
# S3_BUCKET에는 fatell-aws-s3.s3.amazonaws.com/hwaryeok 같은 URL을 넣지 않습니다.
S3_BUCKET=fatell-aws-s3
S3_KEY_PREFIX=hwaryeok
S3_PUBLIC_BASE_URL=https://cdn.hwaryeok.co.kr
AWS_REGION=ap-northeast-2
S3_PRESIGNED_URL_SECONDS=300
# 로컬 Docker에 AWS 키가 꼭 필요한 경우에만 .env에 입력합니다. 운영은 IAM 역할을 권장합니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
