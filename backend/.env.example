DB_URL=jdbc:postgresql://localhost:5432/hwaryeok
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hwaryeok
DB_SCHEMA=hwaryeok
DB_USER=hwaryeok
DB_PASSWORD=replace-with-a-strong-local-password
# Supabase Session Pooler의 연결 한도를 넘지 않도록 작게 유지합니다.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
DB_POOL_NAME=HwaryeokPool
DB_POOL_VALIDATION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_POOL_MAX_LIFETIME_MS=1500000
DB_POOL_KEEPALIVE_MS=120000
DB_POOL_LEAK_DETECTION_MS=60000

# 로컬 PostgreSQL로 Spring Boot를 실행할 때 사용합니다.
SPRING_PROFILES_ACTIVE=postgres

# 여러 프론트 도메인은 쉼표로 구분합니다.
# 예: https://hwaryeok.vercel.app,https://preview.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3001
SERVER_PORT=8081

# 제품 이미지 S3/CDN 저장소입니다. S3_BUCKET에는 호스트나 경로가 아닌 버킷명만 입력합니다.
# CDN 배포의 Origin Path는 /hwaryeok을 가리키도록 구성합니다.
S3_BUCKET=fatell-aws-s3
S3_KEY_PREFIX=hwaryeok
S3_PUBLIC_BASE_URL=https://cdn.hwaryeok.co.kr
AWS_REGION=ap-northeast-2
# 관리자 브라우저가 S3로 직접 PUT할 수 있는 URL의 유효 시간(60~900초)입니다.
S3_PRESIGNED_URL_SECONDS=300
# 로컬에서 IAM 역할/프로필을 사용할 수 없을 때만 실제 값을 backend/.env에 넣습니다. Git에 커밋하지 마세요.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# OAuth 로그인 완료 후 돌아갈 프론트 주소입니다.
OAUTH_FRONTEND_BASE_URL=http://localhost:3001

# 아래 예시 문구는 그대로 사용하면 시작이 차단됩니다. 서로 다른 32바이트 이상의 임의 값으로 교체하세요.
# 생성 예: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
LICENSE_HASH_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
JWT_ISSUER=hwaryeok-api
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=2592000
OAUTH_EXCHANGE_CODE_SECONDS=120
# 쉼표로 구분한 관리자 계정 이메일입니다. 변경 후에는 다시 로그인해야 새 권한 토큰이 발급됩니다.
ADMIN_EMAILS=wings2530@gmail.com
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_RATE_BLOCK_SECONDS=900
LOGIN_RATE_IDENTITY_ATTEMPTS=8
LOGIN_RATE_ADDRESS_ATTEMPTS=100

# 식약처 공공데이터포털 일반 인증키(디코딩 값)와 활용신청 후 표시되는 요청주소입니다.
# 기능성화장품 보고품목: https://www.data.go.kr/data/15095680/openapi.do
# 화장품 사용제한 원료: https://www.data.go.kr/data/15111772/openapi.do
MFDS_API_SERVICE_KEY=
MFDS_FUNCTIONAL_COSMETICS_API_URL=
MFDS_RESTRICTED_INGREDIENTS_API_URL=

# Kakao Developers > 앱 > 플랫폼 키의 REST API 키 / 카카오 로그인 > 보안의 Client Secret
# Redirect URI: http://localhost:8081/login/oauth2/code/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 프론트·백엔드가 서로 다른 HTTPS 도메인일 때만 none/true로 변경합니다.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# 사진 분석: 서버 전용 키. 실제 키를 프론트엔드/NEXT_PUBLIC_* 또는 Git에 넣지 마세요.
OPENAI_API_KEY=
OPENAI_SKIN_PHOTO_ENABLED=false
OPENAI_SKIN_PHOTO_MODEL=gpt-4.1-mini
OPENAI_SKIN_PHOTO_DAILY_LIMIT=3
